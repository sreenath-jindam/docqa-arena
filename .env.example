# Any OpenAI-compatible endpoint. Groq's free tier is the default assumption.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_replace_me
LLM_MODEL=llama-3.1-8b-instant

# The judge should be a stronger model than the generator, otherwise it cannot
# reliably catch the generator's mistakes.
JUDGE_BASE_URL=https://api.groq.com/openai/v1
JUDGE_API_KEY=gsk_replace_me
JUDGE_MODEL=llama-3.3-70b-versatile

# Which config the service loads
DOCQA_CONFIG=configs/local.yaml
# Set to 0 to measure p95 with the embedding cache disabled
DOCQA_CACHE=1
# Where indexes, caches and results are written (set to /kaggle/working in a notebook)
# DOCQA_DATA_DIR=/kaggle/working
